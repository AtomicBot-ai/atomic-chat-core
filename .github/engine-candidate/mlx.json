    "test/contract/engine-pin.test.ts",
    "test/contract/engine-results.test.ts",
    "test/contract/engine-surface.test.ts",
    "test/contract/live-fixtures.test.ts",
    "test/contract/mlx-*",
    "test/fixtures/mlx/",
    "test/live/mlx*",
    "vitest.config.ts"
  ],
  "verified": ["metal"],
  "not_verified": ["draft-models", "kv-quantization", "vision-models"]
