  "live_timeout_minutes": 45,
  "live_files": ["test/live/mlx.test.ts", "test/live/mlx-install.test.ts"],
  "required_live_tests": [
    {
      "file": "test/live/mlx.test.ts",
      "name": "a real mlx-server answers --help with every flag and choice the core passes"
    },
    {
      "file": "test/live/mlx.test.ts",
      "name": "a real mlx-server loads a model folder, answers through the public API and unloads"
    },
    {
      "file": "test/live/mlx.test.ts",
      "name": "a real mlx-server answers a json_schema response_format with JSON that follows the schema"
    },
    {
      "file": "test/live/mlx-install.test.ts",
      "name": "a real mlx-server build installed from its manifest is picked for this host, downloaded, checked, unpacked and probed",
      "tag_pattern": "^mlxvlm-macos-arm64-[0-9a-f]{7,40}$"
    },
    {
      "file": "test/live/mlx-install.test.ts",
      "name": "a real mlx-server build installed from its manifest is ordered by the release date its manifest names",
      "tag_pattern": "^mlxvlm-macos-arm64-[0-9a-f]{7,40}$"
    },
    {
      "file": "test/live/mlx-install.test.ts",
      "name": "a real mlx-server build installed from its manifest is refused when its sha256 does not match the manifest",
      "tag_pattern": "^mlxvlm-macos-arm64-[0-9a-f]{7,40}$"
    }
  ],
  "core_suites": ["unit", "build", "build_bin", "e2e"],
  "protected_paths": [
    ".github/engine-candidate/",
    ".github/workflows/engine-candidate.yml",
    "scripts/engine-candidate.mjs",
    "scripts/engine-surface-diff.mjs",
    "scripts/fetch-live-fixtures.mjs",
    "scripts/lib/",
