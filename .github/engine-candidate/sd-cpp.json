{
  "engine": "sd-cpp",
  "kind": "sdcpp",
  "contract": "test/fixtures/sdcpp/engine-contract.json",
  "default_repo": "AtomicBot-ai/stable-diffusion.cpp",
  "tag_pattern": "^master-\\d+-[0-9a-f]{7}(-a[0-9a-f]{7})?$",
  "pins": "sdcpp-manifest",
  "pin_repo": "AtomicBot-ai/atomic-chat-conf",
  "mirror": false,
  "candidate_manifests": {
    "conf": "backends/sdcpp-manifest.staging.json"
  },
  "upstream": {
    "repo": "leejet/stable-diffusion.cpp",
    "branch": "master"
  },
  "live_models": [
    {
      "id": "diffusion",
      "url": "https://huggingface.co/unsloth/FLUX.2-klein-4B-GGUF/resolve/0084d1df98e2e2137fe776d55170bc4792ec1d66/flux-2-klein-4b-Q4_K_M.gguf",
      "sha256": "0b25d143c8469b342bc5af3bce92b783bf6b0636d285f7b2f75e38af63af9a15",
      "bytes": 2604311104
    },
    {
      "id": "llm",
      "url": "https://huggingface.co/unsloth/Qwen3-4B-Instruct-2507-GGUF/resolve/a06e946bb6b655725eafa393f4a9745d460374c9/Qwen3-4B-Instruct-2507-Q4_K_M.gguf",
      "sha256": "3605803b982cb64aead44f6c1b2ae36e3acdb41d8e46c8a94c6533bc4c67e597",
      "bytes": 2497281120
    },
    {
      "id": "vae",
      "url": "https://huggingface.co/unsloth/FLUX.2-VAE/resolve/bda21a63a9d498e7e718221c75f0a7fed443369f/split_files/vae/flux2-vae.safetensors",
      "sha256": "d64f3a68e1cc4f9f4e29b6e0da38a0204fe9a49f2d4053f0ec1fa1ca02f9c4b5",
      "bytes": 336213556
    }
  ],
  "live_env": {
    "ATOMIC_LIVE_SD_ENGINE": "{engine_dir}",
    "ATOMIC_LIVE_SD_TAG": "{tag}",
    "ATOMIC_LIVE_SD_MANIFEST": "{manifest}",
    "ATOMIC_LIVE_SD_MODEL": "{model:diffusion}",
    "ATOMIC_LIVE_SD_LLM": "{model:llm}",
    "ATOMIC_LIVE_SD_VAE": "{model:vae}",
    "ATOMIC_LIVE_SD_VAE_FORMAT": "flux2",
    "ATOMIC_LIVE_SD_FAMILY": "flux.2-klein",
    "ATOMIC_LIVE_SD_BACKEND": "cpu"
  },
  "platforms": [
    {
      "platform": "linux-x64",
      "runner": "ubuntu-latest"
    },
    {
      "platform": "linux-arm64",
      "runner": "ubuntu-24.04-arm"
    },
    {
      "platform": "macos-arm64",
      "runner": "macos-26",
      "core_runner": "macos-14"
    }
  ],
  "live_timeout_minutes": 90,
  "live_files": ["test/live/diffusion.test.ts", "test/live/diffusion-install.test.ts"],
  "required_live_tests": [
    {
      "file": "test/live/diffusion-install.test.ts",
      "name": "a real stable-diffusion.cpp build installed from its manifest is picked for this host, downloaded, checked, unpacked and probed"
    },
    {
      "file": "test/live/diffusion-install.test.ts",
      "name": "a real stable-diffusion.cpp build installed from its manifest names the commit of its tag"
    },
    {
      "file": "test/live/diffusion-install.test.ts",
      "name": "a real stable-diffusion.cpp build installed from its manifest is refused when its sha256 does not match the manifest"
    },
    {
      "file": "test/live/diffusion.test.ts",
      "name": "a real stable-diffusion.cpp engine answers --help with every flag the core passes"
    },
    {
      "file": "test/live/diffusion.test.ts",
      "name": "a real stable-diffusion.cpp engine installs the tree, loads the model, generates, cancels and unloads"
    }
  ],
  "core_suites": ["unit", "build", "build_bin", "e2e"],
  "protected_paths": [
    ".github/engine-candidate/",
    ".github/workflows/engine-candidate.yml",
    "scripts/engine-candidate.mjs",
    "scripts/engine-surface-diff.mjs",
    "scripts/fetch-live-fixtures.mjs",
    "scripts/lib/",
    "src/diffusion/args.test.ts",
    "test/contract/engine-pin.test.ts",
    "test/contract/engine-results.test.ts",
    "test/contract/engine-surface.test.ts",
    "test/contract/sdcpp-*",
    "test/fixtures/sdcpp/",
    "test/live/diffusion*",
    "vitest.config.ts"
  ],
  "not_verified": ["metal", "cuda", "vulkan", "rocm", "windows"]
}
