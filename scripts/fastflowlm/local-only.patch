diff --git a/src/include/atomic_local.hpp b/src/include/atomic_local.hpp
new file mode 100644
index 0000000..06bb4d7
--- /dev/null
+++ b/src/include/atomic_local.hpp
@@ -0,0 +1,107 @@
+#pragma once
+
+#include <array>
+#include <charconv>
+#include <filesystem>
+#include <fstream>
+#include <stdexcept>
+#include <string_view>
+#include <nlohmann/json.hpp>
+
+namespace atomic_local {
+namespace fs = std::filesystem;
+
+// Set exactly once, before opening the device or starting server threads.
+inline bool enabled = false;
+
+inline fs::path require_path(const char* raw, bool directory) {
+    const fs::path path = raw ? fs::path(raw) : fs::path();
+    if (!path.is_absolute() || !(directory ? fs::is_directory(path) : fs::is_regular_file(path)))
+        throw std::runtime_error("atomic local installation path is missing or invalid");
+    return path;
+}
+
+// Compare dotted versions numerically and reject malformed local metadata.
+inline std::array<unsigned, 3> version(std::string_view value) {
+    std::array<unsigned, 3> result{};
+    for (unsigned i = 0; i < result.size(); ++i) {
+        const char* end = value.data() + value.size();
+        const auto parsed = std::from_chars(value.data(), end, result[i]);
+        if (parsed.ec != std::errc{} || (i == 2 ? parsed.ptr != end :
+            parsed.ptr == end || *parsed.ptr != '.'))
+            throw std::runtime_error("invalid_local_version");
+        if (i < 2) value.remove_prefix(parsed.ptr - value.data() + 1);
+    }
+    return result;
+}
+
+inline fs::path child(const fs::path& root, const fs::path& relative) {
+    if (relative.empty() || relative.has_root_path())
+        throw std::runtime_error("invalid_local_path");
+    for (const auto& part : relative)
+        if (part == "..") throw std::runtime_error("invalid_local_path");
+    const auto resolved = fs::weakly_canonical(root / relative);
+    const auto within = resolved.lexically_relative(fs::canonical(root));
+    if (within.empty() || *within.begin() == "..")
+        throw std::runtime_error("invalid_local_path");
+    return resolved;
+}
+
+inline fs::path check_install(const fs::path& catalog, const fs::path& base,
+                          const std::string& tag, const std::string& build_version) {
+    const auto data = nlohmann::json::parse(std::ifstream(catalog));
+    const auto colon = tag.find(':');
+    const auto& families = data.at("models");
+    if (colon == std::string::npos || families.size() != 1)
+        throw std::runtime_error("invalid_local_catalog");
+    const auto& variants = families.at(tag.substr(0, colon));
+    if (variants.size() != 1) throw std::runtime_error("invalid_local_catalog");
+    const auto& entry = variants.at(tag.substr(colon + 1));
+    auto model = child(base, data.at("model_path").get<std::string>());
+    model = child(model, entry.at("name").get<std::string>());
+    const auto& files = entry.at("files");
+    if (!files.is_array() || files.empty()) throw std::runtime_error("invalid_local_catalog");
+    for (const auto& item : files)
+        if (!fs::is_regular_file(child(model, item.get<std::string>())))
+            throw std::runtime_error("missing_local_file");
+    const auto config = nlohmann::json::parse(std::ifstream(child(model, "config.json")));
+    const auto installed = version(config.at("flm_version").get<std::string>());
+    if (installed < version(entry.at("flm_min_version").get<std::string>()))
+        throw std::runtime_error("outdated_local_model");
+    if (installed > version(build_version)) throw std::runtime_error("newer_local_model");
+    return model;
+}
+
+inline void check_session_install(const fs::path& catalog, const fs::path& base,
+                                  const std::string& tag, const std::string& build_version,
+                                  const fs::path& kernel_root) {
+    const auto model = check_install(catalog, base, tag, build_version);
+    std::error_code error;
+    if (!kernel_root.is_absolute() || !fs::equivalent(model, kernel_root / "xclbins" / model.filename(), error))
+        throw std::runtime_error("invalid_local_kernel_directory");
+}
+
+inline bool allow_route(std::string_view method, std::string_view path) {
+    return (method == "POST" && path == "/v1/chat/completions") ||
+           (method == "GET" && path == "/v1/models");
+}
+
+template <typename Json>
+bool allow_chat(const Json& request, const std::string& model) {
+    if (!request.is_object() || request.contains("backend") ||
+        !request.contains("model") || request.at("model") != model ||
+        !request.contains("messages") || !request.at("messages").is_array()) return false;
+    for (const auto& message : request.at("messages")) {
+        if (!message.is_object() || message.contains("images") || message.contains("audio") ||
+            message.contains("videos")) return false;
+        if (!message.contains("content") || message.at("content").is_null()) continue;
+        const auto& content = message.at("content");
+        if (content.is_string()) continue;
+        if (!content.is_array()) return false;
+        for (const auto& part : content)
+            if (!part.is_object() || !part.contains("type") || part.at("type") != "text" ||
+                !part.contains("text") || !part.at("text").is_string()) return false;
+    }
+    return true;
+}
+}
